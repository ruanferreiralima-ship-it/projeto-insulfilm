    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- App Logic Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // ==========================================
            // 1. GERENCIAMENTO DE TEMA E ACESSIBILIDADE
            // ==========================================
            const htmlEl = document.documentElement;
            const btnContrast = document.getElementById('btn-contrast');
            const btnFontInc = document.getElementById('btn-font-increase');
            const btnFontDec = document.getElementById('btn-font-decrease');
            const btnFontReset = document.getElementById('btn-font-reset');

            let currentFontSizeRem = 1.0;

            // Alternância de Tema (Escuro / Claro / Contraste)
            btnContrast.addEventListener('click', () => {
                const currentTheme = htmlEl.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                htmlEl.setAttribute('data-theme', newTheme);
                showToast(Tema alterado para: ${newTheme === 'dark' ? 'Modo Escuro / Dourado' : 'Modo Alto Contraste / Claro'}, 'info');
            });

            // Controle de tamanho de fontes em tempo real
            btnFontInc.addEventListener('click', () => {
                if (currentFontSizeRem < 1.35) {
                    currentFontSizeRem += 0.05;
                    htmlEl.style.setProperty('--font-scale', ${currentFontSizeRem}rem);
                }
            });

            btnFontDec.addEventListener('click', () => {
                if (currentFontSizeRem > 0.8) {
                    currentFontSizeRem -= 0.05;
                    htmlEl.style.setProperty('--font-scale', ${currentFontSizeRem}rem);
                }
            });

            btnFontReset.addEventListener('click', () => {
                currentFontSizeRem = 1.0;
                htmlEl.style.setProperty('--font-scale', '1rem');
            });

            // Toast feedback padronizado para toda a aplicação
            function showToast(message, type = 'success') {
                const toastEl = document.getElementById('feedbackToast');
                const toastMsg = document.getElementById('toastMessage');
                
                let icon = type === 'success' ? '<i class="fa-solid fa-circle-check text-success fs-5"></i>' :
                           type === 'error' ? '<i class="fa-solid fa-circle-xmark text-danger fs-5"></i>' :
                           '<i class="fa-solid fa-circle-info text-warning fs-5"></i>';

                toastMsg.innerHTML = ${icon} <span>${message}</span>;
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }

            // ==========================================
            // 2. NAVEGAÇÃO SPA (SINGLE PAGE APPLICATION)
            // ==========================================
            const viewRegister = document.getElementById('view-register');
            const viewLogin = document.getElementById('view-login');
            const viewMain = document.getElementById('view-main');

            function navigateTo(viewName) {
                viewRegister.classList.remove('active');
                viewLogin.classList.remove('active');
                viewMain.classList.remove('active');

                if (viewName === 'register') {
                    viewRegister.classList.add('active');
                } else if (viewName === 'login') {
                    viewLogin.classList.add('active');
                } else if (viewName === 'main') {
                    viewMain.classList.add('active');
                    const loggedUser = localStorage.getItem('currentUser') || 'Usuário';
                    document.getElementById('userDisplay').textContent = Bem-vindo, ${loggedUser}!;
                }
            }

            document.getElementById('btn-goto-register').addEventListener('click', () => navigateTo('register'));
            document.getElementById('btn-goto-login').addEventListener('click', () => navigateTo('login'));
            document.getElementById('btn-logout').addEventListener('click', () => {
                localStorage.removeItem('currentUser');
                showToast('Sessão encerrada com sucesso.', 'info');
                navigateTo('login');
            });

            // ==========================================
            // 3. MÁSCARAS E VALIDAÇÃO DE CADASTRO (TELA 1)
            // ==========================================
            const regForm = document.getElementById('registerForm');
            const regCelular = document.getElementById('reg-celular');
            const regFixo = document.getElementById('reg-fixo');

            // Máscara automática para formato de Telefone (+55)XX-XXXXXXXX
            function applyPhoneMask(input) {
                input.addEventListener('input', (e) => {
                    let value = e.target.value.replace(/\D/g, ''); // Apenas dígitos
                    
                    if (value.startsWith('55')) {
                        value = value.substring(2);
                    }

                    if (value.length > 10) {
                        value = value.substring(0, 10);
                    }

                    if (value.length === 0) {
                        e.target.value = '';
                        return;
                    }

                    if (value.length <= 2) {
                        e.target.value = (+55)${value};
                    } else {
                        const ddd = value.substring(0, 2);
                        const num = value.substring(2);
                        e.target.value = (+55)${ddd}-${num};
                    }
                });
            }

            applyPhoneMask(regCelular);
            applyPhoneMask(regFixo);

            // Helpers de validação estritas
            const isAlphaOnly = (str) => /^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$/.test(str);
            const isExactAlpha = (str, len) => new RegExp(^[A-Za-zÀ-ÖØ-öø-ÿ]{${len}}$).test(str);
            const isPhoneFormat = (str) => /^\(\+55\)\d{2}-\d{8}$/.test(str);

            function setFieldError(fieldId, errorId, show) {
                const field = document.getElementById(fieldId);
                const err = document.getElementById(errorId);
                if (show) {
                    field.classList.add('is-invalid-custom');
                    field.classList.remove('is-valid-custom');
                    if (err) err.style.display = 'block';
                } else {
                    field.classList.remove('is-invalid-custom');
                    field.classList.add('is-valid-custom');
                    if (err) err.style.display = 'none';
                }
            }

            // Submissão do Formulário de Cadastro
            regForm.addEventListener('submit', (e) => {
                e.preventDefault();
                let isValid = true;

                // 1. Nome: 15 a 60 caracteres alfabéticos
                const nome = document.getElementById('reg-nome').value.trim();
                if (nome.length >= 15 && nome.length <= 60 && isAlphaOnly(nome)) {
                    setFieldError('reg-nome', 'err-nome', false);
                } else {
                    setFieldError('reg-nome', 'err-nome', true);
                    isValid = false;
                }

                // 2. Data de Nascimento
                const nasco = document.getElementById('reg-nascimento').value;
                if (nasco !== '') {
                    setFieldError('reg-nascimento', 'err-nascimento', false);
                } else {
                    setFieldError('reg-nascimento', 'err-nascimento', true);
                    isValid = false;
                }

                // 3. Sexo
                const sexo = document.getElementById('reg-sexo').value;
                if (sexo !== '') {
                    setFieldError('reg-sexo', 'err-sexo', false);
                } else {
                    setFieldError('reg-sexo', 'err-sexo', true);
                    isValid = false;
                }

                // 4. Nome Materno
                const nomeMaterno = document.getElementById('reg-nome-materno').value.trim();
                if (nomeMaterno.length >= 3 && isAlphaOnly(nomeMaterno)) {
                    setFieldError('reg-nome-materno', 'err-nome-materno', false);
                } else {
                    setFieldError('reg-nome-materno', 'err-nome-materno', true);
                    isValid = false;
                }

                // 5. CPF (Básico não vazio)
                const cpf = document.getElementById('reg-cpf').value.trim();
                if (cpf.length >= 11) {
                    setFieldError('reg-cpf', 'err-cpf', false);
                } else {
                    setFieldError('reg-cpf', 'err-cpf', true);
                    isValid = false;
                }

                // 6. Telefone Celular e Telefone Fixo: (+55)XX-XXXXXXXX
                const celular = regCelular.value.trim();
                if (isPhoneFormat(celular)) {
                    setFieldError('reg-celular', 'err-celular', false);
                } else {
                    setFieldError('reg-celular', 'err-celular', true);
                    isValid = false;
                }

                const fixo = regFixo.value.trim();
                if (isPhoneFormat(fixo)) {
                    setFieldError('reg-fixo', 'err-fixo', false);
                } else {
                    setFieldError('reg-fixo', 'err-fixo', true);
                    isValid = false;
                }

                // 7. Endereço Completo
                const endereco = document.getElementById('reg-endereco').value.trim();
                if (endereco.length >= 5) {
                    setFieldError('reg-endereco', 'err-endereco', false);
                } else {
                    setFieldError('reg-endereco', 'err-endereco', true);
                    isValid = false;
                }

                // 8. Login: exatamente 6 caracteres alfabéticos
                const login = document.getElementById('reg-login').value.trim();
                if (isExactAlpha(login, 6)) {
                    setFieldError('reg-login', 'err-login', false);
                } else {
                    setFieldError('reg-login', 'err-login', true);
                    isValid = false;
                }

                // 9. Senha: exatamente 8 caracteres alfabéticos
                const senha = document.getElementById('reg-senha').value.trim();
                if (isExactAlpha(senha, 8)) {
                    setFieldError('reg-senha', 'err-senha', false);
                } else {
                    setFieldError('reg-senha', 'err-senha', true);
                    isValid = false;
                }

                // 10. Confirma Senha
                const confirmaSenha = document.getElementById('reg-confirma-senha').value.trim();
                if (confirmaSenha === senha && confirmaSenha !== '') {
                    setFieldError('reg-confirma-senha', 'err-confirma-senha', false);
                } else {
                    setFieldError('reg-confirma-senha', 'err-confirma-senha', true);
                    isValid = false;
                }

                if (!isValid) {
                    showToast('Preencha todos os campos corretamente respeitando os pré-requisitos.', 'error');
                    return;
                }

                // Guardar no banco do LocalStorage
                const users = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
                
                // Verificar duplicidade de login
                if (users.some(u => u.login.toLowerCase() === login.toLowerCase())) {
                    setFieldError('reg-login', 'err-login', true);
                    showToast('Este login já está cadastrado no sistema!', 'error');
                    return;
                }

                users.push({ login, senha, nome });
                localStorage.setItem('registeredUsers', JSON.stringify(users));

                showToast('Cadastro realizado com sucesso! Redirecionando para o login...', 'success');
                regForm.reset();

                setTimeout(() => {
                    navigateTo('login');
                }, 1500);
            });

            // ==========================================
            // 4. AUTENTICAÇÃO E LOGIN (TELA 2)
            // ==========================================
            const loginForm = document.getElementById('loginForm');

            loginForm.addEventListener('submit', (e) => {
                e.preventDefault();
                let isValid = true;

                const userVal = document.getElementById('login-user').value.trim();
                const passVal = document.getElementById('login-pass').value.trim();

                // Pré-requisitos de bom senso do login:
                // 1. Não podem estar vazios
                // 2. Login deve ter 6 caracteres alfabéticos, Senha 8 alfabéticos
                if (!isExactAlpha(userVal, 6)) {
                    setFieldError('login-user', 'err-login-user', true);
                    isValid = false;
                } else {
                    setFieldError('login-user', 'err-login-user', false);
                }

                if (!isExactAlpha(passVal, 8)) {
                    setFieldError('login-pass', 'err-login-pass', true);
                    isValid = false;
                } else {
                    setFieldError('login-pass', 'err-login-pass', false);
                }

                if (!isValid) {
                    showToast('Insira um login válido de 6 letras e senha de 8 letras.', 'error');
                    return;
                }

                // Validar credenciais contra usuários salvos
                const users = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
                const foundUser = users.find(u => u.login.toLowerCase() === userVal.toLowerCase() && u.senha === passVal);

                if (foundUser || (userVal === 'ruanus' && passVal === 'senha123')) {
                    // Armazena no LocalStorage do navegador
                    localStorage.setItem('currentUser', userVal);
                    showToast('Login efetuado com sucesso!', 'success');
                    
                    setTimeout(() => {
                        navigateTo('main');
                    }, 800);
                } else {
                    showToast('Login ou senha incorretos! Cadastre-se se ainda não possui conta.', 'error');
                }
            });

            // Verificar se o usuário já possui sessão ativa salva no localStorage
            const savedUser = localStorage.getItem('currentUser');
            if (savedUser) {
                navigateTo('main');
            } else {
                navigateTo('login');
            }
        });
    </script>
