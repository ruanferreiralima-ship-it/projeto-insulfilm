    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // ====================================================
            // 1. TEMA & ACESSIBILIDADE (Fonte & Contraste)
            // ====================================================
            const htmlEl = document.documentElement;
            const btnContrast = document.getElementById('btn-contrast');
            const btnFontInc = document.getElementById('btn-font-increase');
            const btnFontDec = document.getElementById('btn-font-decrease');
            const btnFontReset = document.getElementById('btn-font-reset');

            let currentScale = 1.0;

            btnContrast.addEventListener('click', () => {
                const isDark = htmlEl.getAttribute('data-theme') === 'dark';
                const nextTheme = isDark ? 'light' : 'dark';
                htmlEl.setAttribute('data-theme', nextTheme);
                showToast(`Modo alterado para: ${nextTheme === 'dark' ? 'Escuro / Dourado' : 'Alto Contraste Claro'}`, 'info');
            });

            btnFontInc.addEventListener('click', () => {
                if (currentScale < 1.3) {
                    currentScale += 0.05;
                    htmlEl.style.setProperty('--font-scale', `${currentScale}rem`);
                }
            });

            btnFontDec.addEventListener('click', () => {
                if (currentScale > 0.8) {
                    currentScale -= 0.05;
                    htmlEl.style.setProperty('--font-scale', `${currentScale}rem`);
                }
            });

            btnFontReset.addEventListener('click', () => {
                currentScale = 1.0;
                htmlEl.style.setProperty('--font-scale', '1rem');
            });

            // Toast Feedback Feedback System
            function showToast(message, type = 'success') {
                const toastEl = document.getElementById('feedbackToast');
                const toastMsg = document.getElementById('toastMessage');
                
                let icon = type === 'success' ? '<i class="fa-solid fa-circle-check text-success fs-5"></i>' :
                           type === 'error' ? '<i class="fa-solid fa-circle-xmark text-danger fs-5"></i>' :
                           '<i class="fa-solid fa-circle-info gold-text fs-5"></i>';

                toastMsg.innerHTML = `${icon} <span>${message}</span>`;
                const toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                toast.show();
            }

            // ====================================================
            // 2. SISTEMA DE TELAS (SPA NAVIGATION)
            // ====================================================
            const views = {
                home: document.getElementById('view-home'),
                register: document.getElementById('view-register'),
                login: document.getElementById('view-login'),
                dashboard: document.getElementById('view-dashboard')
            };

            const navLinks = {
                home: document.getElementById('nav-home'),
                eletro: document.getElementById('nav-eletro'),
                peliculas: document.getElementById('nav-peliculas'),
                ppf: document.getElementById('nav-ppf'),
                dashboard: document.getElementById('nav-dashboard')
            };

            function navigateTo(viewKey) {
                // Hide all views
                Object.values(views).forEach(v => v.classList.remove('active'));
                
                // Show requested view
                if (views[viewKey]) {
                    views[viewKey].classList.add('active');
                }

                // Update active state in menu
                Object.values(navLinks).forEach(l => l.classList.remove('active'));
                if (navLinks[viewKey]) navLinks[viewKey].classList.add('active');

                // If Dashboard requested, load user details
                if (viewKey === 'dashboard') {
                    const loggedUser = localStorage.getItem('currentUser');
                    if (!loggedUser) {
                        showToast('Você precisa realizar o login para acessar o painel.', 'error');
                        navigateTo('login');
                        return;
                    }
                    document.getElementById('dashboard-username').textContent = `Bem-vindo, ${loggedUser}!`;
                    renderSavedQuotes();
                }

                // Scroll to top smooth
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Menu Bindings
            document.getElementById('brand-link').addEventListener('click', (e) => { e.preventDefault(); navigateTo('home'); });
            navLinks.home.addEventListener('click', () => navigateTo('home'));
            navLinks.eletro.addEventListener('click', () => { navigateTo('home'); setTimeout(() => document.getElementById('sec-eletro')?.scrollIntoView({behavior: 'smooth'}), 200); });
            navLinks.peliculas.addEventListener('click', () => { navigateTo('home'); setTimeout(() => document.getElementById('sec-peliculas')?.scrollIntoView({behavior: 'smooth'}), 200); });
            navLinks.ppf.addEventListener('click', () => navigateTo('home'));
            navLinks.dashboard.addEventListener('click', () => navigateTo('dashboard'));

            document.getElementById('nav-btn-login').addEventListener('click', () => navigateTo('login'));
            document.getElementById('nav-btn-register').addEventListener('click', () => navigateTo('register'));
            document.getElementById('btn-reg-to-login').addEventListener('click', () => navigateTo('login'));
            document.getElementById('btn-login-to-register').addEventListener('click', () => navigateTo('register'));
            document.getElementById('hero-btn-cad').addEventListener('click', () => navigateTo('register'));
            document.getElementById('hero-btn-calc').addEventListener('click', () => navigateTo('dashboard'));

            document.getElementById('btn-dash-logout').addEventListener('click', () => {
                localStorage.removeItem('currentUser');
                updateAuthNavbar();
                showToast('Sessão encerrada com sucesso.', 'info');
                navigateTo('login');
            });

            function updateAuthNavbar() {
                const loggedUser = localStorage.getItem('currentUser');
                const authArea = document.getElementById('nav-auth-area');
                if (loggedUser) {
                    authArea.innerHTML = `
                        <span class="small text-secondary fw-semibold d-none d-sm-inline"><i class="fa-solid fa-user gold-text me-1"></i>${loggedUser}</span>
                        <button class="btn btn-outline-gold btn-sm" id="nav-btn-logout"><i class="fa-solid fa-right-from-bracket me-1"></i>Sair</button>
                    `;
                    document.getElementById('nav-btn-logout').addEventListener('click', () => {
                        localStorage.removeItem('currentUser');
                        updateAuthNavbar();
                        showToast('Sessão encerrada.', 'info');
                        navigateTo('login');
                    });
                } else {
                    authArea.innerHTML = `
                        <button class="btn btn-outline-gold btn-sm" id="nav-btn-login"><i class="fa-solid fa-right-to-bracket me-1"></i>Login</button>
                        <button class="btn btn-gold btn-sm" id="nav-btn-register"><i class="fa-solid fa-user-plus me-1"></i>Cadastro</button>
                    `;
                    document.getElementById('nav-btn-login').addEventListener('click', () => navigateTo('login'));
                    document.getElementById('nav-btn-register').addEventListener('click', () => navigateTo('register'));
                }
            }
            updateAuthNavbar();

            // ====================================================
            // 3. MÁSCARAS E VALIDAÇÕES DO FORMULÁRIO DE CADASTRO
            // ====================================================
            const regCelular = document.getElementById('reg-celular');
            const regFixo = document.getElementById('reg-fixo');

            function applyPhoneMask(input) {
                input.addEventListener('input', (e) => {
                    let v = e.target.value.replace(/\D/g, ''); // Apenas números
                    if (v.startsWith('55')) v = v.substring(2);
                    if (v.length > 10) v = v.substring(0, 10);

                    if (v.length === 0) {
                        e.target.value = '';
                    } else if (v.length <= 2) {
                        e.target.value = `(+55)${v}`;
                    } else {
                        const ddd = v.substring(0, 2);
                        const rest = v.substring(2);
                        e.target.value = `(+55)${ddd}-${rest}`;
                    }
                });
            }

            applyPhoneMask(regCelular);
            applyPhoneMask(regFixo);

            // RegEx Validators
            const isAlphaWithSpaces = (str) => /^[A-Za-zÀ-ÖØ-öø-ÿ\s]+$/.test(str);
            const isExactAlpha = (str, len) => new RegExp(`^[A-Za-zÀ-ÖØ-öø-ÿ]{${len}}$`).test(str);
            const isPhoneFormat = (str) => /^\(\+55\)\d{2}-\d{8}$/.test(str);

            function toggleFieldError(fieldId, errId, hasError) {
                const el = document.getElementById(fieldId);
                const err = document.getElementById(errId);
                if (hasError) {
                    el.classList.add('is-invalid-custom');
                    el.classList.remove('is-valid-custom');
                    if (err) err.style.display = 'block';
                } else {
                    el.classList.remove('is-invalid-custom');
                    el.classList.add('is-valid-custom');
                    if (err) err.style.display = 'none';
                }
            }

            // Cadastro Submissão (Tela 1)
            document.getElementById('registerForm').addEventListener('submit', (e) => {
                e.preventDefault();
                let valid = true;

                // 1. Nome Completo (15 a 60 alfabéticos)
                const nome = document.getElementById('reg-nome').value.trim();
                if (nome.length >= 15 && nome.length <= 60 && isAlphaWithSpaces(nome)) {
                    toggleFieldError('reg-nome', 'err-nome', false);
                } else {
                    toggleFieldError('reg-nome', 'err-nome', true);
                    valid = false;
                }

                // 2. Data de Nascimento
                const nasco = document.getElementById('reg-nascimento').value;
                if (nasco) {
                    toggleFieldError('reg-nascimento', 'err-nascimento', false);
                } else {
                    toggleFieldError('reg-nascimento', 'err-nascimento', true);
                    valid = false;
                }

                // 3. Sexo
                const sexo = document.getElementById('reg-sexo').value;
                if (sexo) {
                    toggleFieldError('reg-sexo', 'err-sexo', false);
                } else {
                    toggleFieldError('reg-sexo', 'err-sexo', true);
                    valid = false;
                }

                // 4. Nome Materno
                const materno = document.getElementById('reg-nome-materno').value.trim();
                if (materno.length >= 3 && isAlphaWithSpaces(materno)) {
                    toggleFieldError('reg-nome-materno', 'err-nome-materno', false);
                } else {
                    toggleFieldError('reg-nome-materno', 'err-nome-materno', true);
                    valid = false;
                }

                // 5. CPF
                const cpf = document.getElementById('reg-cpf').value.trim();
                if (cpf.length >= 11) {
                    toggleFieldError('reg-cpf', 'err-cpf', false);
                } else {
                    toggleFieldError('reg-cpf', 'err-cpf', true);
                    valid = false;
                }

                // 6 & 7. Celular e Fixo formato (+55)XX-XXXXXXXX
                const celular = regCelular.value.trim();
                if (isPhoneFormat(celular)) {
                    toggleFieldError('reg-celular', 'err-celular', false);
                } else {
                    toggleFieldError('reg-celular', 'err-celular', true);
                    valid = false;
                }

                const fixo = regFixo.value.trim();
                if (isPhoneFormat(fixo)) {
                    toggleFieldError('reg-fixo', 'err-fixo', false);
                } else {
                    toggleFieldError('reg-fixo', 'err-fixo', true);
                    valid = false;
                }

                // 8. Endereço Completo
                const endereco = document.getElementById('reg-endereco').value.trim();
                if (endereco.length >= 5) {
                    toggleFieldError('reg-endereco', 'err-endereco', false);
                } else {
                    toggleFieldError('reg-endereco', 'err-endereco', true);
                    valid = false;
                }

                // 9. Login (exatamente 6 letras)
                const login = document.getElementById('reg-login').value.trim();
                if (isExactAlpha(login, 6)) {
                    toggleFieldError('reg-login', 'err-login', false);
                } else {
                    toggleFieldError('reg-login', 'err-login', true);
                    valid = false;
                }

                // 10. Senha (exatamente 8 letras)
                const senha = document.getElementById('reg-senha').value.trim();
                if (isExactAlpha(senha, 8)) {
                    toggleFieldError('reg-senha', 'err-senha', false);
                } else {
                    toggleFieldError('reg-senha', 'err-senha', true);
                    valid = false;
                }

                // 11. Confirma Senha igual Senha
                const confirma = document.getElementById('reg-confirma-senha').value.trim();
                if (confirma === senha && confirma !== '') {
                    toggleFieldError('reg-confirma-senha', 'err-confirma-senha', false);
                } else {
                    toggleFieldError('reg-confirma-senha', 'err-confirma-senha', true);
                    valid = false;
                }

                if (!valid) {
                    showToast('Corrija os campos destacados com erro.', 'error');
                    return;
                }

                // Save user into LocalStorage
                const registeredUsers = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
                if (registeredUsers.some(u => u.login.toLowerCase() === login.toLowerCase())) {
                    toggleFieldError('reg-login', 'err-login', true);
                    showToast('Este login já foi cadastrado!', 'error');
                    return;
                }

                registeredUsers.push({ login, senha, nome });
                localStorage.setItem('registeredUsers', JSON.stringify(registeredUsers));

                showToast('Usuário cadastrado com sucesso! Redirecionando para login...', 'success');
                document.getElementById('registerForm').reset();

                setTimeout(() => {
                    navigateTo('login');
                }, 1500);
            });

            // ====================================================
            // 4. AUTENTICAÇÃO E LOGIN (Tela 2)
            // ====================================================
            document.getElementById('loginForm').addEventListener('submit', (e) => {
                e.preventDefault();
                let valid = true;

                const userVal = document.getElementById('login-user').value.trim();
                const passVal = document.getElementById('login-pass').value.trim();

                // Validation rules for login (6 alpha chars, 8 alpha chars)
                if (!isExactAlpha(userVal, 6)) {
                    toggleFieldError('login-user', 'err-login-user', true);
                    valid = false;
                } else {
                    toggleFieldError('login-user', 'err-login-user', false);
                }

                if (!isExactAlpha(passVal, 8)) {
                    toggleFieldError('login-pass', 'err-login-pass', true);
                    valid = false;
                } else {
                    toggleFieldError('login-pass', 'err-login-pass', false);
                }

                if (!valid) {
                    showToast('O login deve conter 6 letras e a senha 8 letras.', 'error');
                    return;
                }

                const registeredUsers = JSON.parse(localStorage.getItem('registeredUsers') || '[]');
                const found = registeredUsers.find(u => u.login.toLowerCase() === userVal.toLowerCase() && u.senha === passVal);

                if (found) {
                    localStorage.setItem('currentUser', found.login);
                    updateAuthNavbar();
                    showToast('Login efetuado com sucesso!', 'success');
                    setTimeout(() => navigateTo('dashboard'), 800);
                } else {
                    showToast('Login ou senha incorretos. Cadastre-se caso não tenha conta.', 'error');
                }
            });

            // ====================================================
            // 5. SIMULADOR / CALCULADORA DE ORÇAMENTOS (Tela 3)
            // ====================================================
            const calcCategory = document.getElementById('calc-category');
            const calcType = document.getElementById('calc-type');
            const calcFinish = document.getElementById('calc-finish');
            const calcQty = document.getElementById('calc-qty');
            const calcTotal = document.getElementById('calc-total');

            const catalogOptions = {
                eletro: {
                    types: ['Geladeira', 'Máquina de Lavar', 'Micro-ondas', 'Lava-Louças', 'Fogão', 'Forno'],
                    finishes: [
                        { name: 'Fosco', price: 180 },
                        { name: 'Escovado', price: 230 },
                        { name: 'Brilho', price: 190 },
                        { name: 'Carbono', price: 260 },
                        { name: 'Madeirado', price: 280 },
                        { name: 'Metálico', price: 250 }
                    ]
                },
                veicular: {
                    types: ['Hatch', 'Sedan', 'SUV / Picape', 'Esportivo / Luxury'],
                    finishes: [
                        { name: 'Fumê / Tingida (G5, G20, G35)', price: 220 },
                        { name: 'Carbono Premium', price: 450 },
                        { name: 'Nano Cerâmica High-End', price: 780 },
                        { name: 'Metalizada', price: 380 },
                        { name: 'Película de Segurança', price: 650 }
                    ]
                },
                residencial: {
                    types: ['Janela Padronizada', 'Porta de Vidro / Varanda', 'Divisória de Escritório', 'Fachada / Vitrine'],
                    finishes: [
                        { name: 'Controle Solar / Térmico', price: 120 }, // por m2
                        { name: 'Espelhada / Refletiva', price: 140 },
                        { name: 'Jateada / Decorativa', price: 110 },
                        { name: 'Blackout Total', price: 150 }
                    ]
                },
                ppf: {
                    types: ['Frente Parcial (Capô e Para-choque)', 'Frente Total (Front Clip)', 'Veículo Completo (Full Body)'],
                    finishes: [
                        { name: 'PPF Brilhante Auto-Cicatrizante', price: 1800 },
                        { name: 'PPF Fosco Matte Premium', price: 2200 },
                        { name: 'PPF Hidrofóbico Extra Shield', price: 2500 }
                    ]
                }
            };

            function populateCalcForm() {
                const cat = calcCategory.value;
                const data = catalogOptions[cat];

                calcType.innerHTML = data.types.map(t => `<option value="${t}">${t}</option>`).join('');
                calcFinish.innerHTML = data.finishes.map((f, idx) => `<option value="${idx}">${f.name} - R$ ${f.price}</option>`).join('');

                calculatePrice();
            }

            function calculatePrice() {
                const cat = calcCategory.value;
                const finishIndex = parseInt(calcFinish.value) || 0;
                const qty = parseInt(calcQty.value) || 1;

                const selectedFinish = catalogOptions[cat].finishes[finishIndex];
                const basePrice = selectedFinish ? selectedFinish.price : 0;
                const total = basePrice * qty;

                calcTotal.textContent = `R$ ${total.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
            }

            calcCategory.addEventListener('change', populateCalcForm);
            calcFinish.addEventListener('change', calculatePrice);
            calcQty.addEventListener('input', calculatePrice);
            populateCalcForm();

            // Salvar Orçamento
            document.getElementById('btn-save-quote').addEventListener('click', () => {
                const loggedUser = localStorage.getItem('currentUser');
                if (!loggedUser) {
                    showToast('Faça login para salvar orçamentos.', 'error');
                    navigateTo('login');
                    return;
                }

                const catName = calcCategory.options[calcCategory.selectedIndex].text;
                const typeName = calcType.value;
                const finishName = catalogOptions[calcCategory.value].finishes[calcFinish.value].name;
                const qty = calcQty.value;
                const price = calcTotal.textContent;

                const newQuote = {
                    id: Date.now(),
                    catName,
                    typeName,
                    finishName,
                    qty,
                    price,
                    date: new Date().toLocaleDateString('pt-BR')
                };

                const savedQuotes = JSON.parse(localStorage.getItem(`quotes_${loggedUser}`) || '[]');
                savedQuotes.unshift(newQuote);
                localStorage.setItem(`quotes_${loggedUser}`, JSON.stringify(savedQuotes));

                showToast('Orçamento salvo com sucesso!');
                renderSavedQuotes();
            });

            function renderSavedQuotes() {
                const loggedUser = localStorage.getItem('currentUser');
                const container = document.getElementById('quotes-container');

                if (!loggedUser) {
                    container.innerHTML = '<p class="text-secondary small text-center my-4">Faça login para visualizar.</p>';
                    return;
                }

                const savedQuotes = JSON.parse(localStorage.getItem(`quotes_${loggedUser}`) || '[]');

                if (savedQuotes.length === 0) {
                    container.innerHTML = '<p class="text-secondary small text-center my-4">Nenhum orçamento salvo ainda.</p>';
                    return;
                }

                container.innerHTML = savedQuotes.map(q => `
                    <div class="gold-card p-3 mb-2 bg-secondary position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="gold-text fw-bold small">${q.catName}</span>
                            <span class="text-secondary extra-small">${q.date}</span>
                        </div>
                        <p class="mb-1 fw-semibold small">${q.typeName} - ${q.finishName}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-secondary extra-small">Qtd: ${q.qty}</span>
                            <span class="fw-bold gold-text">${q.price}</span>
                        </div>
                    </div>
                `).join('');
            }

            document.getElementById('btn-clear-quotes').addEventListener('click', () => {
                const loggedUser = localStorage.getItem('currentUser');
                if (loggedUser) {
                    localStorage.removeItem(`quotes_${loggedUser}`);
                    renderSavedQuotes();
                    showToast('Lista de orçamentos limpa.', 'info');
                }
            });

        });
    </script>
</body>
</html>