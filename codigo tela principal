    <style>
        :root {
            --bg-primary: #121212;
            --bg-secondary: #1a1a1a;
            --bg-card: #181818;
            --bg-glass: rgba(26, 26, 26, 0.85);
            --text-primary: #f5f5f5;
            --text-secondary: #b0b0b0;
            --gold-primary: #D4AF37;
            --gold-light: #F3E5AB;
            --gold-dark: #AA7C11;
            --border-gold: rgba(212, 175, 55, 0.35);
            --border-gold-solid: #D4AF37;
            --shadow-gold: 0 4px 20px rgba(212, 175, 55, 0.15);
            --font-scale: 1rem;
            --card-border-radius: 14px;
        }

        /* Light / High Contrast Theme Overrides */
        [data-theme="light"] {
            --bg-primary: #f8f9fa;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --bg-glass: rgba(255, 255, 255, 0.95);
            --text-primary: #111111;
            --text-secondary: #4a4a4a;
            --gold-primary: #8a6800;
            --gold-light: #b38800;
            --gold-dark: #5c4500;
            --border-gold: rgba(138, 104, 0, 0.5);
            --border-gold-solid: #8a6800;
            --shadow-gold: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        html {
            font-size: var(--font-scale);
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Montserrat', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Typography & Brand Headers */
        .brand-title {
            font-family: 'Cinzel', serif;
            letter-spacing: 2px;
            font-weight: 800;
            background: linear-gradient(135deg, #FFF 0%, var(--gold-primary) 50%, var(--gold-light) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-text {
            color: var(--gold-primary) !important;
        }

        .gold-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-gold);
            border-radius: var(--card-border-radius);
            box-shadow: var(--shadow-gold);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        .gold-card:hover {
            border-color: var(--gold-primary);
            box-shadow: 0 8px 30px rgba(212, 175, 55, 0.22);
            transform: translateY(-2px);
        }

        /* Luxury Buttons */
        .btn-gold {
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-dark) 100%);
            color: #000 !important;
            font-weight: 700;
            border: none;
            border-radius: 8px;
            padding: 0.65rem 1.6rem;
            transition: all 0.3s ease;
            letter-spacing: 0.5px;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, var(--gold-light) 0%, var(--gold-primary) 100%);
            box-shadow: 0 0 18px rgba(212, 175, 55, 0.5);
            transform: translateY(-2px);
        }

        .btn-outline-gold {
            border: 1px solid var(--gold-primary);
            color: var(--gold-primary) !important;
            background: transparent;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.65rem 1.6rem;
            transition: all 0.3s ease;
        }

        .btn-outline-gold:hover {
            background-color: var(--gold-primary);
            color: #000 !important;
            box-shadow: 0 0 18px rgba(212, 175, 55, 0.35);
        }

        /* Form Controls */
        .form-control, .form-select {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-gold);
            color: var(--text-primary);
            border-radius: 8px;
            padding: 0.7rem 1rem;
        }

        .form-control:focus, .form-select:focus {
            background-color: var(--bg-secondary);
            color: var(--text-primary);
            border-color: var(--gold-primary);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
        }

        .form-label {
            color: var(--text-primary);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        /* Accessibility Bar */
        .accessibility-bar {
            background-color: var(--bg-secondary);
            border-bottom: 1px solid var(--border-gold);
            padding: 0.5rem 1rem;
            position: sticky;
            top: 0;
            z-index: 1040;
        }

        .access-btn {
            background: transparent;
            border: 1px solid var(--border-gold);
            color: var(--text-primary);
            padding: 0.25rem 0.65rem;
            font-size: 0.85rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .access-btn:hover {
            background: var(--gold-primary);
            color: #000;
        }

        /* Navbar */
        .app-navbar {
            background-color: var(--bg-glass);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border-gold);
            position: sticky;
            top: 41px;
            z-index: 1030;
        }

        .nav-link-custom {
            color: var(--text-primary);
            font-weight: 500;
            padding: 0.5rem 0.9rem;
            border-radius: 6px;
            transition: all 0.2s;
            cursor: pointer;
        }

        .nav-link-custom:hover, .nav-link-custom.active {
            color: var(--gold-primary);
            background: rgba(212, 175, 55, 0.1);
        }

        /* Validation Feedback */
        .invalid-feedback-custom {
            color: #ff5252;
            font-size: 0.82rem;
            margin-top: 0.3rem;
            display: none;
            font-weight: 500;
        }

        .is-invalid-custom {
            border-color: #ff5252 !important;
            box-shadow: 0 0 5px rgba(255, 82, 82, 0.4) !important;
        }

        .is-valid-custom {
            border-color: #2ed573 !important;
        }

        /* View Panel Transitions */
        .view-panel {
            display: none;
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .view-panel.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Badges & Finish Boxes */
        .finish-card {
            background: rgba(212, 175, 55, 0.05);
            border: 1px solid var(--border-gold);
            border-radius: 12px;
            padding: 1.2rem 1rem;
            text-align: center;
            height: 100%;
            transition: all 0.3s ease;
        }

        .finish-card:hover {
            transform: scale(1.03);
            background: rgba(212, 175, 55, 0.12);
            border-color: var(--gold-primary);
        }

        .hero-banner {
            background: linear-gradient(180deg, rgba(18, 18, 18, 0.7) 0%, var(--bg-primary) 100%),
                        radial-gradient(circle at center, rgba(212, 175, 55, 0.2) 0%, transparent 75%);
            border-radius: 20px;
            padding: 3.5rem 1.5rem;
            border: 1px solid var(--border-gold);
            margin-bottom: 2.5rem;
        }

        .extra-small {
            font-size: 0.78rem;
        }
    </style>
</head>
